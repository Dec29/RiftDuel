server {
    listen 443 ssl;
    server_name PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/riftduel-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/riftduel-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:RiftDuelTLS:1m;
    access_log off;
    server_tokens off;

    location = /ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 660s;
        proxy_send_timeout 10s;
    }
    location = /healthz {
        proxy_pass http://127.0.0.1:8080;
        proxy_read_timeout 5s;
    }
    location / { return 404; }
}
