description = "停止攻击，立即回复10费用；投旗至范围内地面敌人所在地块，1秒后落旗格及周围八格敌人受到300%物理伤害与3.5秒眩晕；这九格自投旗起停顿与30%脆弱，持续10秒；不攻击箱子或推球"
effect_type = "flag_burst"
effect_params = {"attack_mult": 1.0, "burst_attack_percent": 300, "stun_ticks": 105, "landing_ticks": 30, "fragile_percent": 30, "instant_cost": 10}
