[sub_resource type="Resource" id="Skill2"]
script = ExtResource("4")
skill_name = "信仰传承"
initial_sp = 15
sp_required = 29
sp_recharge_type = "time"
trigger_type = "manual"
duration = 15.0
description = "停止攻击，15秒内回复20费用；投旗至范围内生命比例最低的普通友军所在地块，该格普通友军防御+50%，每秒恢复琴柳攻击力50%的生命，按本作回复50%折算；技能结束收旗"
effect_type = "flag_heal"
effect_params = {"attack_mult": 1.0, "total_cost": 20, "defense_percent": 50, "regen_attack_percent": 50}
attack_range_override = Array[Vector2i]([Vector2i(2,0), Vector2i(1,-1), Vector2i(1,0), Vector2i(1,1), Vector2i(0,-2), Vector2i(0,-1), Vector2i(0,0), Vector2i(0,1), Vector2i(0,2), Vector2i(-1,-1), Vector2i(-1,0), Vector2i(-1,1), Vector2i(-2,0)])

[sub_resource type="Resource" id="Skill3"]
