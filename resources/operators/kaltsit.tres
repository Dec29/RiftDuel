[sub_resource type="Resource" id="Resource_328w2"]
script = ExtResource("3_47ykn")
skill_name = "指令：战术协同"
sp_required = 8
sp_recharge_type = "time"
description = "自身攻速+100，Mon3tr攻击+90%，每次攻击范围内最多阻挡数个目标，持续20秒。与Mon3tr绑定：它不在场时强制结束、清空并停止回复技力。"
effect_type = "kaltsit_tactical"
effect_params = {
"attack_speed_add": 100,
"mon3tr_attack_percent": 90
}
duration = 20.0

[sub_resource type="Resource" id="Resource_jg30o"]
script = ExtResource("3_47ykn")
skill_name = "指令：熔毁"
sp_required = 15
sp_recharge_type = "time"
description = "Mon3tr防御+200%、真实伤害，攻击加成从+260%在20秒内线性降至0；期间未击杀敌人则结束时流失最大生命50%，可致死，击破箱子或推球不计击杀。绑定：Mon3tr不在场时强制结束、清空并停止回复技力。"
effect_type = "kaltsit_meltdown"
effect_params = {
"attack_peak_percent": 260,
"defense_percent": 200,
"hp_loss_percent": 50
}
duration = 20.0

[sub_resource type="Resource" id="Resource_opajd"]
script = ExtResource("4_bpa1o")
talent_name = "Mon3tr"
description = "可使用和治疗1只Mon3tr：不占编队槽、10费、退场后独立25秒冷却，随本体离场且不触发爆炸；只有凯尔希可直接治疗，范围外防御归0。Mon3tr为召唤物，对单位伤害按近卫40%折算，球推力不折算。"
effect_type = "mon3tr_control"
effect_params = {
"max_count": 1
}

[sub_resource type="Resource" id="Resource_34t6f"]
script = ExtResource("4_bpa1o")
talent_name = "不毁重构"
description = "Mon3tr被击倒（不含撤退或本体离场）后，对周围8格敌人造成1200原始真实伤害及3秒晕眩；真实伤害按近卫40%折算。"
effect_type = "death_rebuild"
effect_params = {
"damage": 1200,
"stun_ticks": 90
}

