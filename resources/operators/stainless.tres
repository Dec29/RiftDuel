[gd_resource type="Resource" script_class="OperatorData" format=3]

[ext_resource type="Script" path="res://data/operator_data.gd" id="operator"]

[ext_resource type="Script" path="res://data/trait_resource.gd" id="trait"]

[ext_resource type="Script" path="res://data/talent_resource.gd" id="talent"]

[ext_resource type="Script" path="res://data/skill_resource.gd" id="skill"]

[sub_resource type="Resource" id="trait"]

script = ExtResource("trait")

trait_name = "工匠"

description = "能够阻挡两个敌人，使用支援装置协助作战"

effect_type = "artisan"

effect_params = {}

[sub_resource type="Resource" id="talent0"]

script = ExtResource("talent")

talent_name = "战地工程师"

description = "可以携带3个(最多可部署2个)，效果根据技能改变而改变"

effect_type = "stainless_supply"

effect_params = {"stock_count":3,"max_count":2}

[sub_resource type="Resource" id="talent1"]

script = ExtResource("talent")

talent_name = "节约经费"

description = "当白铁周围8格的自身装置损毁时，有70%的几率回收使白铁额外获得1个装置"

effect_type = "stainless_recycle"

effect_params = {"chance_percent":70}

[sub_resource type="Resource" id="skill0"]

script = ExtResource("skill")

skill_name = "极致火力"

description = "携带此技能时：装置使一名我方干员的攻击力+12%\n开启时立即获得一个装置，攻击造成相当于200%的物理伤害，装置效果提升至4倍\n技能结束时所有场上的装置被销毁"

effect_type = "stainless_firepower"

effect_params = {"attack_mult":2.0,"device_scale":4}

duration = 20.0

trigger_type = "manual"

initial_sp = 20

sp_required = 45

sp_recharge_type = "time"

attack_range_override = Array[Vector2i]([])

[sub_resource type="Resource" id="skill1"]

script = ExtResource("skill")

skill_name = "高效补给"

description = "携带此技能时：装置使一名我方干员每3.5秒获得1点技力\n攻击力+60%，防御力+60%，攻击所有阻挡的敌人，装置强化为每2秒使目标获得1点技力但生命流失翻倍。\n技能结束时获得一个装置"

effect_type = "stainless_supply_boost"

effect_params = {"attack_mult":1.6,"defense_mult":1.6}

duration = 30.0

trigger_type = "manual"

initial_sp = 25

sp_required = 50

sp_recharge_type = "time"

attack_range_override = Array[Vector2i]([])

[sub_resource type="Resource" id="skill2"]

script = ExtResource("skill")

skill_name = "铁钳号·原型机"

description = "携带此技能时：装置可被我方干员攻击但不会受伤，可通过技能造成群体物理伤害但会流失生命\n开启时立即获得一个装置，攻击力+55%，攻击速度+55"

effect_type = "stainless_prototype"

effect_params = {"attack_mult":1.55,"attack_speed_add":55}

duration = 30.0

trigger_type = "manual"

initial_sp = 20

sp_required = 35

sp_recharge_type = "time"

attack_range_override = Array[Vector2i]([])

[resource]

script = ExtResource("operator")

operator_id = "stainless"

display_name = "白铁"

branch = "工匠"

profession = "辅助"

profession_id = "supporter"

max_health = 2723

attack = 593

defense = 421

magic_resist = 0

damage_type = "physical"

attack_interval = 1.5

block_count = 2

initial_deploy_cost = 15

deploy_cost = 19

redeploy_time = 70.0

attack_range = Array[Vector2i]([Vector2i(0,0), Vector2i(1,0)])

terrain_requirement = "ground"

branch_trait = SubResource("trait")

talent_1 = SubResource("talent0")

talent_2 = SubResource("talent1")

skills = Array[ExtResource("skill")]([SubResource("skill0"),SubResource("skill1"),SubResource("skill2")])
