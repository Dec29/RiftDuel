script = ExtResource("talent")

talent_name = "陈述苦难"

description = "自身生命会不断流失（该效果不会使生命降至0）；生命值高于50%时获得+25%攻击力的精力充沛；高于80%效果翻倍"

effect_type = "fiammetta_suffering"

effect_params = {"pulse_ticks":3,"loss_basis_points":50,"hp_threshold_percent":50,"attack_percent":25,"high_hp_threshold_percent":80,"high_attack_percent":50}

