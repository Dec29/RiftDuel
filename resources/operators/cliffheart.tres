[ext_resource type="Script" path="res://data/talent_resource.gd" id="3"]
[ext_resource type="Script" path="res://data/skill_resource.gd" id="4"]

[sub_resource type="Resource" id="Trait"]
script = ExtResource("2")
trait_name = "钩索师"
description = "技能可以位移敌人；可以放于高台。"
effect_type = "puller"
effect_params = {}

[sub_resource type="Resource" id="Talent1"]
script = ExtResource("3")
talent_name = "雪境猎手"
description = "未自身阻挡敌人时攻击力与防御力各+12%。"
effect_type = "unblocked_atk_def"
effect_params = {"attack_percent": 12, "defense_percent": 12}

[sub_resource type="Resource" id="Talent2"]
script = ExtResource("3")
talent_name = ""
description = ""
effect_type = "none"
effect_params = {}

[sub_resource type="Resource" id="Skill1"]
script = ExtResource("4")
skill_name = "锁链勾爪"
initial_sp = 0
sp_required = 4
sp_recharge_type = "time"
trigger_type = "attack"
duration = 0.0
description = "下次攻击以力度3按本作力差位移拖拽最远敌人，造成180%法术伤害；角色目标维持最多5秒阻回，仍可普攻。无敌人时可击箱一次，或按180%原始攻击推力向自身拉静止球。"
effect_type = "pull_strike"
effect_params = {"attack_mult": 1.8, "shift_force": 3, "channel_ticks": 150}

[sub_resource type="Resource" id="Skill2"]
script = ExtResource("4")
skill_name = "束缚链"
initial_sp = 10
sp_required = 15
sp_recharge_type = "time"
trigger_type = "manual"
duration = 0.0
description = "前方至多3个最远敌人，200%真实伤害、力度3按本作力差位移拖拽；移动结束后眩晕3秒，拉不动则5秒后眩晕；锁链期间阻回但仍可普攻。无敌人时可击箱一次，或按200%原始攻击推力向自身拉静止球。"
effect_type = "pull_chain"
effect_params = {"attack_mult": 2.0, "shift_force": 3, "channel_ticks": 150, "target_count": 3, "stun_ticks": 90}
attack_range_override = Array[Vector2i]([Vector2i(1,1), Vector2i(2,1), Vector2i(3,1), Vector2i(0,0), Vector2i(1,0), Vector2i(2,0), Vector2i(3,0), Vector2i(1,-1), Vector2i(2,-1), Vector2i(3,-1)])

