script = ExtResource("2")
trait_name = "领主"
description = "可以进行远程攻击，但此时攻击力降低至80%；本作无移动阻挡，单位与球普通攻击均按远攻折算，技能1强化攻击及技能2／3生效时免折算"
effect_type = "ranged_attack"
effect_params = {"attack_percent": 80}

[sub_resource type="Resource" id="Talent1"]
