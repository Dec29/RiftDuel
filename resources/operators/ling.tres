[sub_resource type="Resource" id="Trait"]
script = ExtResource("2")
trait_name = "召唤师"
description = "攻击造成<@ba.kw>法术伤害</>\\n可以使用<@ba.kw>召唤物</>协助作战"
effect_type = "summoner"
effect_params = {}
[sub_resource type="Resource" id="Talent1"]
script = ExtResource("3")
talent_name = "挑灯问梦"
description = "携带5个召唤物，最多3份在场额度，功能随技能改变；高级弦惊占2份。"
effect_type = "ling_supply"
effect_params = {"stock_count": 5, "max_count": 3}
[sub_resource type="Resource" id="Talent2"]
script = ExtResource("3")
talent_name = "随付笺咏醉屠苏"
description = "召唤物被击倒、吸收或回收时额外获得3SP、攻击+3%，最多5层；重新部署清空。"
effect_type = "ling_recycle"
effect_params = {"sp_add": 3, "attack_percent": 3, "max_stacks": 5}
