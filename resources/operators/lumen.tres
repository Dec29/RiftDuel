[sub_resource type="Resource" id="Resource_tawup"]
script = ExtResource("1_5gso8")
trait_name = "疗养师"
description = "较大治疗范围，近距七格以外治疗量变为80%；本作所有普通治疗再按50%折算，优先生命比例最低的伤员。"
effect_type = "therapist"
effect_params = {
"far_heal_percent": 80
}

[sub_resource type="Resource" id="Resource_8j1rk"]
script = ExtResource("3_j7roj")
skill_name = "沐雨"
trigger_type = "attack"
sp_required = 10
sp_recharge_type = "time"
description = "下次治疗改为在目标格形成5秒雨区，目标格及周围八格每秒接受55%攻击力治疗；雨区每秒结算一次，按近远距离和治疗系数折算。"
effect_type = "lumen_rain"
effect_params = {
"heal_percent": 55,
"pulse_count": 5,
"pulse_ticks": 30
}

[sub_resource type="Resource" id="Resource_754a3"]
script = ExtResource("3_j7roj")
skill_name = "沛霖"
initial_sp = 5
sp_required = 13
sp_recharge_type = "time"
description = "立即治疗范围内最多3名友方260%攻击力生命。技力可蓄力至26，开启消耗全部技力；蓄力后额外清除眩晕、沉默、束缚和停顿，不解除外力位移。满血控制者亦可被蓄力技能选中。"
effect_type = "lumen_cleanse"
effect_params = {
"charge_count": 2,
"heal_percent": 260,
"target_count": 3
}

[sub_resource type="Resource" id="Resource_2o8gs"]
script = ExtResource("3_j7roj")
skill_name = "灯火不灭"
sp_required = 50
sp_recharge_type = "time"
description = "攻击+55%、攻速+30，优先治疗处于眩晕、沉默、束缚或停顿的伤员；仅治疗这些目标时消耗1弹，该次治疗变为攻击力200%并清除这四类状态，不解除外力位移。8发耗尽结束，可手动停止；普通伤员治疗不耗弹。"
effect_type = "lumen_lamp"
effect_params = {
"ammo_count": 8,
"attack_mult": 1.55,
"attack_speed_add": 30,
"heal_mult": 2.0
}
duration = -1.0

[sub_resource type="Resource" id="Resource_wjpnr"]
