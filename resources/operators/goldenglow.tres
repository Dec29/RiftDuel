[sub_resource type="Resource" id="trait"]

script = ExtResource("trait")

trait_name = "驭械术师"

description = "操作浮游单元对敌人造成法术伤害\n浮游单元连续攻击同一敌人时伤害提升（最高造成干员110%攻击力的伤害）"

effect_type = "mechanical_float"

effect_params = {"initial_attack_percent":20,"attack_step_percent":15,"max_attack_percent":110}

[sub_resource type="Resource" id="talent0"]

script = ExtResource("talent")

talent_name = "信标的愤怒"

description = "技能开启后浮游单元攻击时有10%概率自爆（回到干员身边）对小范围敌人造成澄闪300%攻击力的法术伤害\n自爆按原作独立递增概率：初始每层1.5%，未触发加一层，达到40层后的下一击必定自爆；自爆后回到本体并重置。"

effect_type = "drone_explosion"

effect_params = {"probability_step_basis_points":150,"max_stacks":40,"attack_percent":300,"splash_radius_squared":1}

[sub_resource type="Resource" id="talent1"]

script = ExtResource("talent")

talent_name = "精准导流"

description = "自身与浮游单元无视敌人15点法术抗性"

effect_type = "flat_resist_penetration"

effect_params = {"resist_ignore":15}

[sub_resource type="Resource" id="skill0"]

script = ExtResource("skill")

skill_name = "火花四溅"

description = "浮游单元+1，释放浮游单元锁定敌人攻击，攻击力+40%，攻击速度+50\n浮游单元锁敌后直至敌人被击杀、自爆或技能结束后返回干员身边"

effect_type = "goldenglow_sparks"

effect_params = {"attack_mult":1.4,"attack_speed_add":50,"drone_count":2}

duration = 25.0

trigger_type = "manual"

initial_sp = 20

sp_required = 35

sp_recharge_type = "time"

attack_range_override = Array[Vector2i]([])

[sub_resource type="Resource" id="skill1"]

