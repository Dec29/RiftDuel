[sub_resource type="Resource" id="skill2"]

script = ExtResource("skill")

skill_name = "澄净闪耀"

description = "停止攻击，浮游单元+2，释放浮游单元锁定敌人攻击，攻击范围扩大至整个战场，攻击力+80%，浮游单元攻击附带0.5秒停顿\n浮游单元锁敌后直至敌人被击杀、自爆或技能结束后返回干员身边\n本作适配：全场范围只用于敌方单位；箱子与球仅在本体基础范围内索敌。"

effect_type = "goldenglow_global"

effect_params = {"attack_mult":1.8,"drone_count":3,"slow_ticks":15}

duration = 30.0

trigger_type = "manual"

initial_sp = 17

sp_required = 35

sp_recharge_type = "time"

