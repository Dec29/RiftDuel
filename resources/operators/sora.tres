[sub_resource type="Resource" id="Skill1"]
script = ExtResource("4")
skill_name = "睡眠之歌"
initial_sp = 45
sp_required = 60
sp_recharge_type = "time"
trigger_type = "manual"
duration = 7.0
description = "扩大范围，7秒歌声期间持续施加睡眠，统一随技能结束到期；离开范围不提前醒来，解除后仍在歌声内会再次入睡。睡眠期间不可选中、免伤、阻挡0，禁止普攻与新开技能；技力、技能计时及已释放独立效果继续。生命回复速度提高至每秒100%攻击力。"
effect_type = "bard_sleep"
effect_params = {"regen_attack_percent": 100}
attack_range_override = Array[Vector2i]([Vector2i(-1,2), Vector2i(0,2), Vector2i(1,2), Vector2i(-2,1), Vector2i(-1,1), Vector2i(0,1), Vector2i(1,1), Vector2i(2,1), Vector2i(-2,0), Vector2i(-1,0), Vector2i(0,0), Vector2i(1,0), Vector2i(2,0), Vector2i(-2,-1), Vector2i(-1,-1), Vector2i(0,-1), Vector2i(1,-1), Vector2i(2,-1), Vector2i(-1,-2), Vector2i(0,-2), Vector2i(1,-2)])

[sub_resource type="Resource" id="Skill2"]
