effect_params = {"heal_percent": 120, "low_heal_percent": 140, "hp_threshold_percent": 50}

[sub_resource type="Resource" id="Skill0"]
script = ExtResource("4")
skill_name = "精准痛击"
initial_sp = 10
sp_required = 25
sp_recharge_type = "time"
