duration = 25.0
attack_range_override = Array[Vector2i]([])

[sub_resource type="Resource" id="Skill1"]
script = ExtResource("4")
skill_name = "链锯强袭"
initial_sp = 25
sp_required = 35
sp_recharge_type = "time"
trigger_type = "manual"
description = "攻击范围扩大，攻击+180%、防御+50%；攻击未被阻挡的敌人时，中等力度2向本体拖拽。持续40秒。"
effect_type = "gavial_pull"
effect_params = {"attack_mult": 2.8, "defense_mult": 1.5, "shift_force": 2}
duration = 40.0
attack_range_override = Array[Vector2i]([Vector2i(1, 1), Vector2i(2, 1), Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(1, -1), Vector2i(2, -1)])

