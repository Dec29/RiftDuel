[sub_resource type="Resource" id="Trait"]
script = ExtResource("2")
trait_name = "链愈师"
description = "恢复友方单位生命，且会在<@ba.kw>3</>个友方单位间跳跃，每次跳跃治疗量降低25%"
effect_type = "chain_medic"
effect_params = {"target_count": 3, "jump_heal_percent": 75, "jump_radius_squared": 2}
[sub_resource type="Resource" id="Talent1"]
script = ExtResource("3")
talent_name = "自我修复"
description = "攻击范围内可部署一个3费重构体，仅自身直接治疗；重构体周围友方攻击+15%，治疗经过重构体时增加一次不衰减跳跃。"
effect_type = "monstr_reconstruct"
effect_params = {"max_count": 1, "attack_percent": 15}
[sub_resource type="Resource" id="Talent2"]
script = ExtResource("3")
talent_name = "战术协同"
description = "本体或重构体造成治疗时，目标与本体攻速+20，持续10秒；同类取最高。"
effect_type = "monstr_synergy"
effect_params = {"attack_speed_add": 20, "duration_ticks": 300}
