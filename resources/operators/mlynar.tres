[sub_resource type="Resource" id="Trait"]
script = ExtResource("2")
trait_name = "解放者"
description = "通常不攻击且阻挡数为0；技能未开启时30秒内攻击力逐渐提升至+200%，技能结束时重置攻击力。"
effect_type = "liberator"
effect_params = {"charge_ticks": 900, "max_attack_bonus_percent": 200}

[sub_resource type="Resource" id="Talent0"]
script = ExtResource("3")
talent_name = "游侠"
description = "攻击敌人时攻击力提升至110%。周围存在3名及以上敌人时攻击力提升至115%且受到的伤害减少15%"
effect_type = "mlynar_roamer"
effect_params = {"attack_percent": 110, "surrounded_attack_percent": 115, "enemy_count": 3, "damage_reduce_percent": 15}

[sub_resource type="Resource" id="Talent1"]
script = ExtResource("3")
talent_name = "无动于衷"
description = "在场时，自身更容易受到攻击，所有卡西米尔干员被攻击时反弹相当于玛恩纳攻击力15%的真实伤害"
effect_type = "mlynar_indifference"
effect_params = {"taunt_level": 1, "reflect_attack_percent": 15}

[sub_resource type="Resource" id="Skill0"]
script = ExtResource("4")
skill_name = "未声张的怒火"
initial_sp = 15
sp_required = 30
sp_recharge_type = "time"
trigger_type = "manual"
description = "30秒内普通攻击造成200%攻击力物理伤害，防御+60%。"
effect_type = "mlynar_anger"
effect_params = {"attack_mult": 1.0, "strike_mult": 2.0, "defense_mult": 1.6}
duration = 30.0
attack_range_override = Array[Vector2i]([])

[sub_resource type="Resource" id="Skill1"]
script = ExtResource("4")
skill_name = "未宽解的悲哀"
initial_sp = 10
sp_required = 25
sp_recharge_type = "time"
trigger_type = "manual"
description = "攻击间隔+0.3秒、范围扩大，造成两次190%攻击力物理伤害，持续20秒，可主动关闭。本体直接击杀敌方普通干员后，结束时保留特性蓄力；召唤物与反伤击杀不计。"
effect_type = "mlynar_sorrow"
effect_params = {"attack_mult": 1.0, "strike_mult": 1.9, "attack_interval_add": 0.3, "shot_count": 2}
duration = 20.0
attack_range_override = Array[Vector2i]([Vector2i(0, 1), Vector2i(1, 1), Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(0, -1), Vector2i(1, -1)])

[sub_resource type="Resource" id="Skill2"]
script = ExtResource("4")
skill_name = "未照耀的荣光"
initial_sp = 20
sp_required = 42
sp_recharge_type = "time"
trigger_type = "manual"
description = "攻击范围扩大，特性攻击加成翻倍，本体每直接击杀敌方普通干员减少10个百分点（召唤物与反伤击杀不计）；最多5敌各180%物理，范围内卡西米尔伤害额外附加玛恩纳12%攻击力真伤。持续28秒。"
effect_type = "mlynar_glory"
effect_params = {"attack_mult": 1.0, "strike_mult": 1.8, "target_count": 5, "trait_multiplier": 2, "kill_reduce_percent": 10, "true_attack_percent": 12}
