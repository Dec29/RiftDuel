[sub_resource type="Resource" id="trait"]

script = ExtResource("trait")

trait_name = "行商"

description = "再部署时间减少，撤退时不返还部署费用，在场时每3秒消耗3点部署费用（不足时自动撤退）"

effect_type = "cost_drain"

effect_params = {"drain_amount": 3, "drain_interval": 3.0}

[sub_resource type="Resource" id="talent0"]

