[gd_resource type="Resource" format=3]
[ext_resource type="Script" path="res://data/operator_data.gd" id="1"]
[ext_resource type="Script" path="res://data/trait_resource.gd" id="2"]
[ext_resource type="Script" path="res://data/talent_resource.gd" id="3"]
[ext_resource type="Script" path="res://data/skill_resource.gd" id="4"]

[sub_resource type="Resource" id="trait"]
script = ExtResource("2")
trait_name = "处决者·虚影特性"
description = "无法接受治疗，生命回复速度仍可生效；伤害按特种折算；撤退无返费"
effect_type = "executor_clone"
effect_params = {"source_profession_id":"specialist"}
[sub_resource type="Resource" id="talent1"]
script = ExtResource("3")
talent_name = ""
description = "本体在场时可部署一个虚影，不占编队槽；本体退场后已部署虚影仍保留"
effect_type = "none"
effect_params = {}
[sub_resource type="Resource" id="talent2"]
script = ExtResource("3")
talent_name = "虚影精通"
description = "镜中虚影再部署时间减少10秒，独立从部署起算"
effect_type = "clone_redeploy_reduction"
effect_params = {"reduction_seconds":10}
[sub_resource type="Resource" id="skill"]
script = ExtResource("4")
trigger_type = "passive"
skill_name = "暗夜魅影"
description = "部署后物理闪避+50%，获得自身当前最大生命80%的物理护盾，两者持续10秒"
effect_type = "deploy_physical_shield"
effect_params = {"dodge_physical_add":50,"shield_health_percent":80}
sp_required = 0
sp_recharge_type = "passive"
duration = 10.0
[sub_resource type="Resource" id="skill1"]
script = ExtResource("4")
skill_name = "血色乐章"
sp_required = 0
sp_recharge_type = "passive"
trigger_type = "passive"
description = "部署获得10层攻击力+20%的增益；每次实际攻击单位、箱子或球消耗一层，无论伤害是否被抵挡"
effect_type = "deploy_attack_stacks"
effect_params = {"stack_count":10, "attack_percent_per_stack":20}
duration = -1.0

[sub_resource type="Resource" id="skill2"]
script = ExtResource("4")
skill_name = "夜幕突袭"
sp_required = 0
sp_recharge_type = "passive"
trigger_type = "passive"
description = "部署对周围八格敌方单位造成300%物理伤害，并统一随机施加停顿、束缚或眩晕4.5秒；小力度1推开，受目标重量及路径阻挡限制"
effect_type = "deploy_control_burst"
effect_params = {"attack_mult":3.0, "control_ticks":135, "shift_force":1}
duration = -1.0
burst_range_override = Array[Vector2i]([Vector2i(-1,-1), Vector2i(0,-1), Vector2i(1,-1), Vector2i(-1,0), Vector2i(1,0), Vector2i(-1,1), Vector2i(0,1), Vector2i(1,1)])

[resource]
script = ExtResource("1")
operator_id = "phantom_clone"
display_name = "镜中虚影"
profession = "召唤物"
profession_id = "summon"
branch = "处决者"
max_health = 1416
attack = 548
defense = 268
magic_resist = 0
damage_type = "physical"
attack_interval = 0.93
block_count = 1
deploy_cost = 5
redeploy_time = 45.0
initial_sp = 0
terrain_requirement = "ground"
attack_range = Array[Vector2i]([Vector2i(0,0),Vector2i(1,0)])
branch_trait = SubResource("trait")
talent_1 = SubResource("talent1")
talent_2 = SubResource("talent2")
skills = Array[ExtResource("4")]([SubResource("skill"), SubResource("skill1"), SubResource("skill2")])
