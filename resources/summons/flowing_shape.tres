[gd_resource type="Resource" format=3]
[ext_resource type="Script" path="res://data/trait_resource.gd" id="trait"]
[ext_resource type="Script" path="res://data/talent_resource.gd" id="talent"]
[ext_resource type="Script" path="res://data/skill_resource.gd" id="skill"]
[ext_resource type="Script" path="res://data/operator_data.gd" id="op"]
[sub_resource type="Resource" id="trait"]
script = ExtResource("trait")
trait_name = "流形"
description = "禁直接治疗，战术点期间无敌且阻挡0；原始流形可手选复制，分裂体无独立技能。"
effect_type = "flowing_shape"
effect_params = {"source_profession_id":"vanguard","split_lifetime_ticks":750,"split_attack_count":10,"steal_per_hit":10,"steal_limit":250}
[sub_resource type="Resource" id="none"]
script = ExtResource("talent")
talent_name = "无"
description = "效果由绑定本体和召唤物特性结算。"
effect_type = "none"
effect_params = {}
[sub_resource type="Resource" id="skill"]
script = ExtResource("skill")
skill_name = "流形"
initial_sp = 95
sp_required = 100
trigger_type = "manual"
sp_recharge_type = "time"
description = "开启20秒手选复制窗口；可主动关闭，仅本体未开技且原始流形处于实体形态可用。"
effect_type = "flow_copy"
effect_params = {"attack_mult":1.0}
duration = 20.0
[resource]
script = ExtResource("op")
operator_id = "flowing_shape"
display_name = "流形"
profession = "召唤物"
profession_id = "summon"
branch = "流形"
max_health = 2000
attack = 302
defense = 257
magic_resist = 0
block_count = 0
deploy_cost = 0
redeploy_time = 10.0
damage_type = "magical"
attack_interval = 1.5
terrain_requirement = "ground"
attack_range = Array[Vector2i]([Vector2i(0,0)])
branch_trait = SubResource("trait")
