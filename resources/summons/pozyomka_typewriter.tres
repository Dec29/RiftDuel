effect_params = {"attack_mult": 1.6, "chance_percent": 40, "critical_mult": 2.25}

initial_sp = 0

sp_required = 20

sp_recharge_type = "on_hit"

trigger_type = "auto"

duration = -1.0

attack_range_override = Array[Vector2i]([])

description = "攻击力+60%，攻击时40%概率当次攻击力提升至225%；持续无限。"

[sub_resource type="Resource" id="skill1"]

script = ExtResource("skill")

skill_name = "点题"

